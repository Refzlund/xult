		"@svitejs/changesets-changelog-github-compact": "^1.2.0",
		"@types/bun": "^1",
		"@typescript/native-preview": "^7.0.0-dev.20251101.1",
		"oxlint": "^1.25.0",
		"oxlint-tsgolint": "^0.4.0",
		"rolldown": "^1.0.0-beta.45",
		"rolldown-plugin-dts": "^0.17.3",
